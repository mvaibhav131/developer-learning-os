{
  "name": "developer-learning-os",
  "version": "1.0.0",
  "private": true,
  "description": "Developer Learning OS - a local-first personal learning platform for AI engineering, DSA, system design, full-stack mastery and senior interview preparation.",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:api": "pnpm --filter @dlos/api dev",
    "dev:web": "pnpm --filter @dlos/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @dlos/api start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @dlos/web test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @dlos/api db:generate",
    "db:migrate": "pnpm --filter @dlos/api db:migrate",
    "db:seed": "pnpm --filter @dlos/api db:seed",
    "db:reset": "pnpm --filter @dlos/api db:reset",
    "db:backup": "pnpm --filter @dlos/api db:backup",
    "content:validate": "pnpm --filter @dlos/learning-content validate",
    "content:videos": "pnpm --filter @dlos/learning-content videos:sync",
    "licenses:check": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "catalog:",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  }
}
