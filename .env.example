# Copy to `.env` (git-ignored) and adjust. Every value below has a safe default.
# No paid API key is required anywhere in this project.

# --- API server --------------------------------------------------------------
NODE_ENV=development
# Keep 127.0.0.1 unless you add authentication. This app has a single local profile.
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info

# SQLite file, relative to the repository root. Use :memory: for throwaway runs.
DATABASE_PATH=data/dlos.sqlite
AUTO_MIGRATE=true
AUTO_SEED=true

# Origins allowed to call the API from a browser (comma separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Host headers accepted by the API (protects a local service from DNS rebinding).
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
RATE_LIMIT_PER_MINUTE=600

# --- Personalisation (applies only when the database is first created) -------
OWNER_DISPLAY_NAME=Learner
# IANA time zone used for "today", streaks and the calendar. Default: this machine's zone.
# APP_TIMEZONE=Asia/Kolkata

# --- Web app (Vite dev server) -----------------------------------------------
WEB_PORT=5173

# --- Optional AI providers (Phase 5+; the platform works fully without them) --
# AI_PROVIDER=none            # none | ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
