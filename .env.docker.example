# Settings for docker compose. Copy this file to .env.docker, edit it and start with:
#   docker compose --env-file .env.docker up -d --build
# .env.docker is ignored by git, so your password never gets committed.

# Port on this machine, and the address it is published on.
# 127.0.0.1 keeps it private. Use 0.0.0.0 only together with BASIC_AUTH_* or behind a proxy that signs users in.
PORT=8080
BIND_ADDRESS=127.0.0.1

# The address you type in the browser. Required when it is not http://localhost:<PORT>.
# PUBLIC_URL=https://learn.example.com

# Your time zone (IANA name). It decides when a study day starts and ends.
APP_TIMEZONE=Asia/Kolkata
OWNER_DISPLAY_NAME=Learner

# Sign-in for anything reachable from the internet. Both or neither. The password needs at least 12 characters.
# BASIC_AUTH_USER=owner
# BASIC_AUTH_PASSWORD=choose-a-long-passphrase

# Number of reverse proxies in front of the app (1 behind Caddy, nginx, Render or Fly). 0 when it is reached directly.
TRUST_PROXY=0
LOG_LEVEL=info
